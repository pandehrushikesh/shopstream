{
  "Logging": { "LogLevel": { "Default": "Warning", "ShopStream": "Information" } },
  "AllowedHosts": "*",
  "RateLimiting": {
    "Instances": 3,
    "InstanceName": "gw1",
    "Redis": "localhost:6379,abortConnect=false,connectTimeout=500,asyncTimeout=150",
    "BreakerDuration": "00:00:05"
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": { "ClusterId": "catalog", "Match": { "Path": "/api/{**catch-all}" } }
    },
    "Clusters": {
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:5101/" } } }
    }
  }
}
